# Local development values only. Never put real secrets here.
# Copy to .env:  cp .env.example .env

# --- application ---
APP_NAME=wallet-service
APP_ENV=local
# APP_INSTANCE_ID defaults to the container hostname.
LOG_LEVEL=info

# --- http ---
HTTP_ADDR=:8080
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

# --- postgres (container) ---
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_PORT=5432

# --- keycloak (container) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

# --- ministack (SQS emulator) ---
MINISTACK_PORT=4566
